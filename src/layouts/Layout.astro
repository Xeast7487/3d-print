---
export interface Props { title: string; description?: string; }
const { title, description = 'Impressions 3D sur commande — Figurines, pièces, prototypes. Qualité professionnelle, livraison rapide.' } = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --primary:      #4F46E5;
      --primary-dark: #4338CA;
      --primary-glow: rgba(79,70,229,0.14);
      --secondary:    #10B981;
      --amber:        #F59E0B;
      --bg:           #FFFFFF;
      --bg-alt:       #F8FAFC;
      --bg-section:   #F0F4FF;
      --text:         #0F172A;
      --text-muted:   #64748B;
      --border:       #E2E8F0;
      --dark:         #0F172A;
      --dark-2:       #1E293B;
      /* Compatibility aliases — used by admin page */
      --accent:      #F97316;
      --accent-dark: #EA6700;
      --accent-glow: rgba(249,115,22,0.15);
      --bg-2:        #111111;
      --bg-3:        #1A1A1A;
      --white:       #F5F5F5;
      --gray:        rgba(245,245,245,0.5);
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Manrope', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; overflow-x: hidden; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; object-fit: cover; }

    .slide-up        { opacity: 0; transform: translateY(28px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .slide-up.visible { opacity: 1; transform: none; }
    .pop-in          { opacity: 0; transform: scale(0.93); transition: opacity 0.6s ease, transform 0.6s ease; }
    .pop-in.visible  { opacity: 1; transform: none; }
    .slide-right     { opacity: 0; transform: translateX(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .slide-right.visible { opacity: 1; transform: none; }
    .d1 { transition-delay: 0.08s; }
    .d2 { transition-delay: 0.16s; }
    .d3 { transition-delay: 0.24s; }
    .d4 { transition-delay: 0.32s; }
    .d5 { transition-delay: 0.40s; }

    @keyframes floatY { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
    @keyframes spinRing { to { transform: rotate(360deg); } }

    .text-primary { color: var(--primary); }
    .text-gradient {
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg-alt); }
    ::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 2px; }
  </style>
</head>
<body>
  <slot />

  <!-- Chat widget -->
  <div id="cw-btn" title="Nous écrire">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span id="cw-badge"></span>
  </div>

  <div id="cw-panel">
    <div id="cw-head">
      <div class="cw-ava">🖨️</div>
      <div class="cw-hinfo">
        <p class="cw-name">Fab3D</p>
        <p class="cw-status"><span class="cw-dot"></span>En ligne · répond vite</p>
      </div>
      <button id="cw-close" aria-label="Fermer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="cw-body">
      <div class="cw-intro">
        <div class="cw-intro-ava">🖨️</div>
        <div class="cw-intro-bubble">
          <p>Salut ! 👋 Tu as une question sur une impression ? Je réponds rapidement.</p>
        </div>
      </div>
    </div>
    <div id="cw-foot">
      <input id="cw-input" placeholder="Écris ton message..." autocomplete="off" maxlength="500" />
      <button id="cw-send" aria-label="Envoyer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>

  <style>
    #cw-btn {
      position: fixed; bottom: 1.75rem; right: 1.75rem; z-index: 9999;
      width: 54px; height: 54px; border-radius: 14px;
      background: var(--primary);
      color: #fff; display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      box-shadow: 0 8px 28px rgba(79,70,229,0.45);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    #cw-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(79,70,229,0.55); }
    #cw-badge {
      position: absolute; top: -4px; right: -4px;
      background: #ef4444; color: #fff;
      min-width: 18px; height: 18px; border-radius: 9px; padding: 0 4px;
      font-size: 10px; font-weight: 700;
      display: none; align-items: center; justify-content: center;
      border: 2px solid #fff; font-family: sans-serif;
    }

    #cw-panel {
      position: fixed; bottom: 5.5rem; right: 1.75rem; z-index: 9998;
      width: 360px; max-height: 540px;
      display: flex; flex-direction: column;
      background: #fff;
      border-radius: 20px; overflow: hidden;
      box-shadow: 0 24px 64px rgba(15,23,42,0.14), 0 0 0 1px rgba(15,23,42,0.06);
      font-family: 'Manrope', -apple-system, sans-serif;
      opacity: 0; pointer-events: none;
      transform: translateY(14px) scale(0.97);
      transition: opacity 0.22s cubic-bezier(0.22,1,0.36,1), transform 0.22s cubic-bezier(0.22,1,0.36,1);
    }
    #cw-panel.open { opacity: 1; pointer-events: all; transform: none; }

    #cw-head {
      flex-shrink: 0;
      display: flex; align-items: center; gap: 0.75rem;
      padding: 1.1rem 1.25rem 1rem;
      background: var(--primary);
    }
    .cw-ava {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      background: rgba(255,255,255,0.18);
      display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .cw-hinfo { flex: 1; min-width: 0; }
    .cw-name  { font-size: 0.88rem; font-weight: 700; color: #fff; }
    .cw-status { display: flex; align-items: center; gap: 0.3rem; margin-top: 2px; font-size: 0.68rem; color: rgba(255,255,255,0.72); }
    .cw-dot   { width: 6px; height: 6px; border-radius: 50%; background: #86efac; flex-shrink: 0; }
    #cw-close {
      background: rgba(255,255,255,0.14); border: none; cursor: pointer;
      width: 28px; height: 28px; border-radius: 8px;
      color: rgba(255,255,255,0.8); display: flex; align-items: center; justify-content: center;
      transition: background 0.15s; flex-shrink: 0;
    }
    #cw-close:hover { background: rgba(255,255,255,0.25); color: #fff; }

    #cw-body {
      flex: 1; overflow-y: auto; overflow-x: hidden;
      padding: 1rem 1rem 0.5rem;
      background: #F8FAFC;
      display: flex; flex-direction: column; gap: 0.35rem; min-height: 0;
    }
    #cw-body::-webkit-scrollbar { width: 0; }

    .cw-intro { display: flex; align-items: flex-end; gap: 0.5rem; margin-bottom: 0.25rem; }
    .cw-intro-ava {
      width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
      background: var(--primary);
      display: flex; align-items: center; justify-content: center; font-size: 0.8rem;
    }
    .cw-intro-bubble {
      background: #fff; border-radius: 4px 14px 14px 14px;
      padding: 0.65rem 0.9rem; max-width: 82%;
      box-shadow: 0 2px 8px rgba(15,23,42,0.08);
    }
    .cw-intro-bubble p { font-size: 0.84rem; color: #374151; line-height: 1.55; margin: 0; }

    .cw-grp { display: flex; flex-direction: column; gap: 2px; margin-bottom: 0.5rem; }
    .cw-grp.me  { align-items: flex-end; }
    .cw-grp.you { align-items: flex-start; flex-direction: row; align-items: flex-end; gap: 0.5rem; }
    .cw-grp.you .cw-msgs { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; }
    .cw-grp-ava {
      width: 26px; height: 26px; border-radius: 8px; flex-shrink: 0;
      background: var(--primary);
      display: flex; align-items: center; justify-content: center; font-size: 0.72rem; align-self: flex-end;
    }

    .cw-b {
      max-width: 78%; padding: 0.6rem 0.9rem;
      font-size: 0.845rem; line-height: 1.5; word-break: break-word;
      animation: cwPop 0.16s ease-out both;
    }
    @keyframes cwPop { from { opacity:0; transform: translateY(6px) scale(0.95); } to { opacity:1; transform: none; } }

    .cw-grp.me .cw-b {
      background: var(--primary); color: #fff;
      border-radius: 14px 14px 4px 14px;
      box-shadow: 0 3px 10px rgba(79,70,229,0.28);
    }
    .cw-grp.me .cw-b:not(:first-child) { border-radius: 14px 4px 4px 14px; }
    .cw-grp.me .cw-b:last-child        { border-radius: 14px 4px 14px 14px; }

    .cw-grp.you .cw-b {
      background: #fff; color: #374151;
      box-shadow: 0 2px 8px rgba(15,23,42,0.08);
      border-radius: 4px 14px 14px 14px;
    }
    .cw-grp.you .cw-b:not(:last-child) { border-radius: 4px 14px 4px 4px; }
    .cw-grp.you .cw-b:last-child        { border-radius: 4px 14px 14px 14px; }

    .cw-meta { font-size: 0.62rem; color: #9CA3AF; margin-top: 3px; padding: 0 3px; }
    .cw-grp.me  .cw-meta { text-align: right; }
    .cw-grp.you .cw-meta { text-align: left; padding-left: 0.5rem; }

    .cw-typing { display: flex; align-items: flex-end; gap: 0.5rem; }
    .cw-typing-ava {
      width: 26px; height: 26px; border-radius: 8px; flex-shrink: 0;
      background: var(--primary);
      display: flex; align-items: center; justify-content: center; font-size: 0.72rem;
    }
    .cw-typing-b {
      background: #fff; box-shadow: 0 2px 8px rgba(15,23,42,0.08);
      border-radius: 4px 14px 14px 14px;
      padding: 0.7rem 0.9rem; display: flex; gap: 4px; align-items: center;
    }
    .cw-typing-b span {
      width: 6px; height: 6px; border-radius: 50%; background: #CBD5E1;
      animation: cwDot 1.4s ease infinite; display: block;
    }
    .cw-typing-b span:nth-child(2) { animation-delay: 0.2s; }
    .cw-typing-b span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes cwDot { 0%,60%,100%{transform:scale(0.7);opacity:0.35} 30%{transform:scale(1.1);opacity:1} }

    #cw-foot {
      flex-shrink: 0; display: flex; align-items: center; gap: 0.5rem;
      padding: 0.75rem; background: #fff; border-top: 1px solid #F1F5F9;
    }
    #cw-input {
      flex: 1; background: #F1F5F9;
      border: 1.5px solid transparent;
      color: #0F172A; border-radius: 10px;
      padding: 0.6rem 0.9rem; font-size: 0.84rem;
      outline: none; font-family: inherit;
      transition: border-color 0.2s, background 0.2s;
    }
    #cw-input:focus { border-color: var(--primary); background: #fff; }
    #cw-input::placeholder { color: #94A3B8; }
    #cw-send {
      width: 36px; height: 36px; flex-shrink: 0;
      background: var(--primary); border: none; border-radius: 10px;
      color: #fff; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s, transform 0.1s;
    }
    #cw-send:hover  { background: var(--primary-dark); }
    #cw-send:active { transform: scale(0.93); }

    @media (max-width: 480px) {
      #cw-panel { width: calc(100vw - 2rem); right: 1rem; }
      #cw-btn   { bottom: 1.25rem; right: 1.25rem; }
    }
  </style>

  <script>
    const SB_URL = 'https://gnpjilwdehxsafdqdtak.supabase.co';
    const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImducGppbHdkZWh4c2FmZHFkdGFrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5Nzk3NjIsImV4cCI6MjA5NTU1NTc2Mn0.iFYR9r5ZZsKcc9n2N8jPtFTLs0QDTIqR3KMCMhCdSdA';

    const cwBtn   = document.getElementById('cw-btn');
    const cwPanel = document.getElementById('cw-panel');
    const cwClose = document.getElementById('cw-close');
    const cwInput = document.getElementById('cw-input');
    const cwSend  = document.getElementById('cw-send');
    const cwBody  = document.getElementById('cw-body');
    const cwBadge = document.getElementById('cw-badge');

    let sessionId    = localStorage.getItem('chat_3dp_sid');
    let isOpen       = false;
    let pollTimer    = null;
    let unseenCount  = 0;
    let lastTs       = localStorage.getItem('chat_3dp_ts') || new Date(0).toISOString();
    let typingEl     = null;

    cwBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      cwPanel.classList.toggle('open', isOpen);
      if (isOpen) {
        unseenCount = 0; cwBadge.style.display = 'none';
        loadMessages(); startPoll(); setTimeout(() => cwInput.focus(), 200);
      } else { stopPoll(); }
    });
    cwClose.addEventListener('click', () => { isOpen = false; cwPanel.classList.remove('open'); stopPoll(); });

    async function sbApi(path, opts = {}) {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
        headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json', Prefer: 'return=representation', ...opts.headers },
        ...opts,
      });
      const t = await r.text();
      return t ? JSON.parse(t) : null;
    }

    async function getSession() {
      if (sessionId) return sessionId;
      const d = await sbApi('chat_sessions', { method: 'POST', body: JSON.stringify({ site: '3d-print', visitor_name: 'Visiteur' }) });
      sessionId = d[0].id;
      localStorage.setItem('chat_3dp_sid', sessionId);
      return sessionId;
    }

    function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function renderMsg(msg, animate = true) {
      if (document.querySelector(`[data-mid="${msg.id}"]`)) return;
      const isMe = msg.sender === 'visitor';
      const side = isMe ? 'me' : 'you';
      const time  = new Date(msg.created_at).toLocaleTimeString('fr-CA', { hour: '2-digit', minute: '2-digit' });
      const anim  = animate ? '' : 'style="animation:none"';

      const prevGroup = cwBody.lastElementChild?.classList.contains('cw-grp') && cwBody.lastElementChild?.classList.contains(side)
        ? cwBody.lastElementChild : null;

      if (prevGroup) {
        const msgsContainer = prevGroup.querySelector('.cw-msgs') || prevGroup;
        const bubble = document.createElement('div');
        bubble.className = 'cw-b'; bubble.dataset.mid = msg.id;
        bubble.setAttribute('style', animate ? '' : 'animation:none');
        bubble.textContent = msg.message;
        msgsContainer.appendChild(bubble);
        const metaEl = prevGroup.querySelector('.cw-meta');
        if (metaEl) metaEl.textContent = time;
      } else {
        const grp = document.createElement('div');
        grp.className = `cw-grp ${side}`;
        if (isMe) {
          grp.innerHTML = `<div class="cw-b" data-mid="${msg.id}" ${anim}>${escHtml(msg.message)}</div><span class="cw-meta">${time}</span>`;
        } else {
          grp.innerHTML = `<div class="cw-grp-ava">🖨️</div><div class="cw-msgs"><div class="cw-b" data-mid="${msg.id}" ${anim}>${escHtml(msg.message)}</div><span class="cw-meta">${time}</span></div>`;
        }
        cwBody.appendChild(grp);
      }

      cwBody.scrollTop = cwBody.scrollHeight;
      lastTs = msg.created_at;
      localStorage.setItem('chat_3dp_ts', lastTs);
    }

    function showTyping() {
      if (typingEl) return;
      typingEl = document.createElement('div');
      typingEl.className = 'cw-typing';
      typingEl.innerHTML = `<div class="cw-typing-ava">🖨️</div><div class="cw-typing-b"><span></span><span></span><span></span></div>`;
      cwBody.appendChild(typingEl);
      cwBody.scrollTop = cwBody.scrollHeight;
    }
    function hideTyping() { typingEl?.remove(); typingEl = null; }

    async function loadMessages() {
      if (!sessionId) return;
      const msgs = await sbApi(`chat_messages?session_id=eq.${sessionId}&order=created_at.asc`);
      if (!msgs?.length) return;
      msgs.forEach(m => renderMsg(m, false));
    }

    async function poll() {
      if (!sessionId) return;
      try {
        const ts = encodeURIComponent(lastTs);
        const msgs = await sbApi(`chat_messages?session_id=eq.${sessionId}&created_at=gt.${ts}&order=created_at.asc`);
        if (!msgs?.length) return;
        hideTyping();
        msgs.forEach(m => {
          renderMsg(m, true);
          if (m.sender === 'owner' && !isOpen) { unseenCount++; cwBadge.textContent = unseenCount; cwBadge.style.display = 'flex'; }
        });
      } catch {}
    }

    function startPoll() { if (!pollTimer) pollTimer = setInterval(poll, 4000); }
    function stopPoll()  { clearInterval(pollTimer); pollTimer = null; }

    async function doSend() {
      const text = cwInput.value.trim();
      if (!text) return;
      cwInput.value = ''; cwInput.disabled = true;
      const sid = await getSession();
      try {
        const d = await sbApi('chat_messages', { method: 'POST', body: JSON.stringify({ session_id: sid, sender: 'visitor', message: text }) });
        if (d?.[0]) renderMsg(d[0], true);
        showTyping(); startPoll();
      } catch { console.error('Send failed'); }
      cwInput.disabled = false; cwInput.focus();
    }

    cwSend.addEventListener('click', doSend);
    cwInput.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); doSend(); } });

    if (sessionId) { loadMessages(); startPoll(); }
  </script>

  <script>
    document.querySelectorAll('.slide-up, .pop-in, .slide-right').forEach(el =>
      new IntersectionObserver(entries => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')), { threshold: 0.1 }).observe(el)
    );
    document.querySelectorAll('[data-count]').forEach(el => {
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          const target = +e.target.dataset.count, suffix = e.target.dataset.suffix || '';
          const t0 = performance.now();
          const tick = now => {
            const p = Math.min((now - t0) / 1600, 1);
            e.target.textContent = Math.floor(target * (1 - Math.pow(1 - p, 3))) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          io.unobserve(e.target);
        });
      }, { threshold: 0.5 });
      io.observe(el);
    });
  </script>
</body>
</html>
