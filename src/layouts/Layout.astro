---
export interface Props { title: string; description?: string; }
const { title, description = 'Impressions 3D sur commande — Figurines, pièces, prototypes. Qualité professionnelle, livraison rapide.' } = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent:      #F97316;
      --accent-dark: #EA6700;
      --accent-glow: rgba(249,115,22,0.15);
      --bg:          #0A0A0A;
      --bg-2:        #111111;
      --bg-3:        #1A1A1A;
      --border:      rgba(255,255,255,0.08);
      --white:       #F5F5F5;
      --gray:        rgba(245,245,245,0.5);
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Space Grotesk', sans-serif; background: var(--bg); color: var(--white); min-height: 100vh; overflow-x: hidden; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; object-fit: cover; }

    .reveal       { opacity: 0; transform: translateY(24px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .reveal.visible { opacity: 1; transform: none; }
    .reveal-scale { opacity: 0; transform: scale(0.94); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal-scale.visible { opacity: 1; transform: none; }
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }

    @keyframes shimmer {
      0%   { background-position: -300% center; }
      100% { background-position:  300% center; }
    }
    .text-accent { color: var(--accent); }
    .text-shimmer {
      background: linear-gradient(90deg, #F97316 0%, #FBBF24 40%, #F97316 70%, #FB923C 100%);
      background-size: 300% auto;
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      animation: shimmer 3.5s linear infinite;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }
  </style>
</head>
<body>
  <slot />
  <!-- Chat widget -->
  <div id="cw-btn" title="Nous écrire">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span id="cw-badge"></span>
  </div>

  <div id="cw-panel">
    <div id="cw-head">
      <div class="cw-avatar">🖨️</div>
      <div class="cw-hinfo">
        <p class="cw-name">3D Print</p>
        <p class="cw-status"><span class="cw-dot"></span>En ligne</p>
      </div>
      <button id="cw-close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="cw-body">
      <div class="cw-welcome">
        <p>👋 Bonjour ! Une question sur une impression ? Écris-nous, on répond rapidement.</p>
      </div>
    </div>
    <div id="cw-foot">
      <input id="cw-input" placeholder="Votre message..." autocomplete="off" maxlength="500" />
      <button id="cw-send">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>

  <style>
    /* ── Bouton ── */
    #cw-btn {
      position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999;
      width: 58px; height: 58px; border-radius: 50%;
      background: linear-gradient(135deg, #F97316, #FBBF24);
      color: #0A0A0A; display: flex; align-items: center; justify-content: center;
      cursor: pointer; box-shadow: 0 4px 20px rgba(249,115,22,0.45), 0 0 0 0 rgba(249,115,22,0.3);
      transition: transform 0.2s, box-shadow 0.2s;
      animation: cwPulse 3s ease infinite;
    }
    @keyframes cwPulse {
      0%,100% { box-shadow: 0 4px 20px rgba(249,115,22,0.45), 0 0 0 0 rgba(249,115,22,0.25); }
      50%      { box-shadow: 0 4px 28px rgba(249,115,22,0.6), 0 0 0 10px rgba(249,115,22,0); }
    }
    #cw-btn:hover { transform: scale(1.07); }
    #cw-badge {
      position: absolute; top: -3px; right: -3px;
      background: #ef4444; color: #fff;
      min-width: 18px; height: 18px; border-radius: 9px;
      font-size: 10px; font-weight: 700; padding: 0 4px;
      display: none; align-items: center; justify-content: center;
      border: 2px solid #0A0A0A;
    }

    /* ── Panel ── */
    #cw-panel {
      position: fixed; bottom: 5.5rem; right: 1.5rem; z-index: 9998;
      width: 350px; height: 500px;
      background: #0f0f0f;
      border: 1px solid rgba(249,115,22,0.2);
      border-radius: 20px; overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 12px 50px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04);
      font-family: 'Space Grotesk', sans-serif;
      opacity: 0; pointer-events: none;
      transform: translateY(12px) scale(0.97);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    #cw-panel.open { opacity: 1; pointer-events: all; transform: translateY(0) scale(1); }

    /* ── Header ── */
    #cw-head {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 1rem 1.25rem;
      background: linear-gradient(135deg, rgba(249,115,22,0.15), rgba(251,191,36,0.08));
      border-bottom: 1px solid rgba(249,115,22,0.15);
    }
    .cw-avatar { font-size: 1.6rem; line-height: 1; }
    .cw-hinfo { flex: 1; }
    .cw-name { font-size: 0.9rem; font-weight: 700; color: #f0f0f0; }
    .cw-status { display: flex; align-items: center; gap: 0.35rem; font-size: 0.7rem; color: rgba(240,240,240,0.5); margin-top: 0.1rem; }
    .cw-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 5px #4ade80; animation: cwBlink 2s infinite; flex-shrink: 0; }
    @keyframes cwBlink { 0%,100%{opacity:1}50%{opacity:0.4} }
    #cw-close { background: none; border: none; cursor: pointer; color: rgba(240,240,240,0.4); padding: 4px; border-radius: 6px; display: flex; transition: color 0.2s, background 0.2s; }
    #cw-close:hover { color: #f0f0f0; background: rgba(255,255,255,0.06); }

    /* ── Messages ── */
    #cw-body { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
    #cw-body::-webkit-scrollbar { width: 3px; }
    #cw-body::-webkit-scrollbar-thumb { background: rgba(249,115,22,0.3); border-radius: 2px; }
    .cw-welcome { background: rgba(249,115,22,0.08); border: 1px solid rgba(249,115,22,0.15); border-radius: 12px; padding: 0.85rem 1rem; }
    .cw-welcome p { font-size: 0.82rem; color: rgba(240,240,240,0.7); line-height: 1.55; }
    .cw-row { display: flex; flex-direction: column; }
    .cw-row.me  { align-items: flex-end; }
    .cw-row.you { align-items: flex-start; }
    .cw-bubble {
      max-width: 80%; padding: 0.6rem 0.95rem; border-radius: 16px;
      font-size: 0.83rem; line-height: 1.5; word-break: break-word;
      animation: cwPop 0.18s ease-out both;
    }
    @keyframes cwPop { from { opacity:0; transform: scale(0.9); } to { opacity:1; transform: none; } }
    .cw-row.me  .cw-bubble { background: #F97316; color: #0A0A0A; font-weight: 500; border-bottom-right-radius: 4px; }
    .cw-row.you .cw-bubble { background: #1c1c1c; color: #f0f0f0; border: 1px solid rgba(255,255,255,0.07); border-bottom-left-radius: 4px; }
    .cw-time { font-size: 0.62rem; color: rgba(240,240,240,0.25); margin-top: 0.25rem; padding: 0 0.2rem; }
    .cw-sender { font-size: 0.68rem; font-weight: 600; color: #F97316; margin-bottom: 0.2rem; padding: 0 0.2rem; }

    /* Typing indicator */
    .cw-typing .cw-bubble { background: #1c1c1c; border: 1px solid rgba(255,255,255,0.07); padding: 0.7rem 1rem; }
    .cw-dots { display: flex; gap: 4px; }
    .cw-dots span { width: 6px; height: 6px; border-radius: 50%; background: rgba(240,240,240,0.4); animation: cwDot 1.2s infinite; }
    .cw-dots span:nth-child(2) { animation-delay: 0.2s; }
    .cw-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes cwDot { 0%,80%,100%{transform:scale(0.7);opacity:0.4}40%{transform:scale(1);opacity:1} }

    /* ── Footer ── */
    #cw-foot { padding: 0.85rem; border-top: 1px solid rgba(255,255,255,0.06); display: flex; gap: 0.5rem; background: #0a0a0a; }
    #cw-input {
      flex: 1; background: #1a1a1a; border: 1px solid rgba(255,255,255,0.08);
      color: #f0f0f0; border-radius: 10px; padding: 0.6rem 0.9rem;
      font-size: 0.83rem; outline: none; font-family: inherit;
      transition: border-color 0.2s;
    }
    #cw-input:focus { border-color: rgba(249,115,22,0.5); }
    #cw-input::placeholder { color: rgba(240,240,240,0.3); }
    #cw-send {
      width: 38px; height: 38px; flex-shrink: 0;
      background: #F97316; border: none; border-radius: 10px;
      color: #0a0a0a; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.2s, transform 0.15s;
    }
    #cw-send:hover { background: #EA6700; transform: scale(1.05); }
    #cw-send:active { transform: scale(0.97); }

    @media (max-width: 480px) {
      #cw-panel { width: calc(100vw - 2rem); right: 1rem; bottom: 5.5rem; }
    }
  </style>

  <script>
    const SB_URL = 'https://gnpjilwdehxsafdqdtak.supabase.co';
    const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImducGppbHdkZWh4c2FmZHFkdGFrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5Nzk3NjIsImV4cCI6MjA5NTU1NTc2Mn0.iFYR9r5ZZsKcc9n2N8jPtFTLs0QDTIqR3KMCMhCdSdA';

    const cwBtn   = document.getElementById('cw-btn');
    const cwPanel = document.getElementById('cw-panel');
    const cwClose = document.getElementById('cw-close');
    const cwInput = document.getElementById('cw-input');
    const cwSend  = document.getElementById('cw-send');
    const cwBody  = document.getElementById('cw-body');
    const cwBadge = document.getElementById('cw-badge');

    let sessionId    = localStorage.getItem('chat_3dp_sid');
    let isOpen       = false;
    let pollTimer    = null;
    let unseenCount  = 0;
    let lastTs       = localStorage.getItem('chat_3dp_ts') || new Date(0).toISOString();
    let typingEl     = null;

    // ── Toggle ──────────────────────────────────────────────────
    cwBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      cwPanel.classList.toggle('open', isOpen);
      if (isOpen) {
        unseenCount = 0; cwBadge.style.display = 'none';
        loadMessages(); startPoll(); setTimeout(() => cwInput.focus(), 200);
      } else { stopPoll(); }
    });
    cwClose.addEventListener('click', () => { isOpen = false; cwPanel.classList.remove('open'); stopPoll(); });

    // ── Supabase REST helper ─────────────────────────────────────
    async function sbApi(path, opts = {}) {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
        headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json', Prefer: 'return=representation', ...opts.headers },
        ...opts,
      });
      const t = await r.text();
      return t ? JSON.parse(t) : null;
    }

    // ── Session ──────────────────────────────────────────────────
    async function getSession() {
      if (sessionId) return sessionId;
      const d = await sbApi('chat_sessions', { method: 'POST', body: JSON.stringify({ site: '3d-print', visitor_name: 'Visiteur' }) });
      sessionId = d[0].id;
      localStorage.setItem('chat_3dp_sid', sessionId);
      return sessionId;
    }

    // ── Render messages ─────────────────────────────────────────
    function renderMsg(msg, animate = true) {
      if (document.querySelector(`[data-mid="${msg.id}"]`)) return;
      const isMe = msg.sender === 'visitor';
      const row  = document.createElement('div');
      row.className = `cw-row ${isMe ? 'me' : 'you'}`;
      row.dataset.mid = msg.id;
      const time = new Date(msg.created_at).toLocaleTimeString('fr-CA', { hour: '2-digit', minute: '2-digit' });
      row.innerHTML = `
        ${!isMe ? '<p class="cw-sender">3D Print</p>' : ''}
        <div class="cw-bubble" ${animate ? '' : 'style="animation:none"'}>${escHtml(msg.message)}</div>
        <span class="cw-time">${time}</span>`;
      cwBody.appendChild(row);
      cwBody.scrollTop = cwBody.scrollHeight;
      lastTs = msg.created_at;
      localStorage.setItem('chat_3dp_ts', lastTs);
    }

    function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function showTyping() {
      if (typingEl) return;
      typingEl = document.createElement('div');
      typingEl.className = 'cw-row you cw-typing';
      typingEl.innerHTML = '<div class="cw-bubble"><div class="cw-dots"><span></span><span></span><span></span></div></div>';
      cwBody.appendChild(typingEl);
      cwBody.scrollTop = cwBody.scrollHeight;
    }
    function hideTyping() { typingEl?.remove(); typingEl = null; }

    // ── Load all messages ────────────────────────────────────────
    async function loadMessages() {
      if (!sessionId) return;
      const msgs = await sbApi(`chat_messages?session_id=eq.${sessionId}&order=created_at.asc`);
      if (!msgs?.length) return;
      msgs.forEach(m => renderMsg(m, false));
    }

    // ── Poll new messages ────────────────────────────────────────
    async function poll() {
      if (!sessionId) return;
      try {
        const ts = encodeURIComponent(lastTs);
        const msgs = await sbApi(`chat_messages?session_id=eq.${sessionId}&created_at=gt.${ts}&order=created_at.asc`);
        if (!msgs?.length) return;
        hideTyping();
        msgs.forEach(m => {
          renderMsg(m, true);
          if (m.sender === 'owner' && !isOpen) { unseenCount++; cwBadge.textContent = unseenCount; cwBadge.style.display = 'flex'; }
        });
      } catch {}
    }

    function startPoll() { if (!pollTimer) pollTimer = setInterval(poll, 4000); }
    function stopPoll()  { clearInterval(pollTimer); pollTimer = null; }

    // ── Send ─────────────────────────────────────────────────────
    async function doSend() {
      const text = cwInput.value.trim();
      if (!text) return;
      cwInput.value = ''; cwInput.disabled = true;
      const sid = await getSession();
      try {
        const d = await sbApi('chat_messages', { method: 'POST', body: JSON.stringify({ session_id: sid, sender: 'visitor', message: text }) });
        if (d?.[0]) renderMsg(d[0], true);
        showTyping();
        startPoll();
      } catch { console.error('Send failed'); }
      cwInput.disabled = false; cwInput.focus();
    }

    cwSend.addEventListener('click', doSend);
    cwInput.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); doSend(); } });

    // Auto-load if session exists
    if (sessionId) { loadMessages(); startPoll(); }
  </script>
  <script>
    document.querySelectorAll('.reveal, .reveal-scale').forEach(el =>
      new IntersectionObserver(entries => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')), { threshold: 0.1 }).observe(el)
    );
    document.querySelectorAll('[data-count]').forEach(el => {
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          const target = +e.target.dataset.count, suffix = e.target.dataset.suffix||'';
          const t0 = performance.now();
          const tick = now => {
            const p = Math.min((now-t0)/1600, 1);
            e.target.textContent = Math.floor(target*(1-Math.pow(1-p,3)))+suffix;
            if (p<1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          io.unobserve(e.target);
        });
      }, { threshold: 0.5 });
      io.observe(el);
    });
  </script>
</body>
</html>
